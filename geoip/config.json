{
  "input": [
    {
      "type": "private",
      "action": "add"
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "ru",
        "uri": "https://raw.githubusercontent.com/ipverse/rir-ip/master/country/ru/ipv4-aggregated.txt",
        "onlyIPType": "ipv4"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "ru",
        "uri": "https://raw.githubusercontent.com/ipverse/rir-ip/master/country/ru/ipv6-aggregated.txt",
        "onlyIPType": "ipv6"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "ru-blocked",
        "uri": "https://raw.githubusercontent.com/1andrevich/Re-filter-lists/main/ipsum.lst"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "discord",
        "uri": "https://raw.githubusercontent.com/1andrevich/Re-filter-lists/main/discord_ips.lst"
      }
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip.dat",
        "wantedList": ["private", "ru", "ru-blocked", "discord"]
      }
    }
  ]
}
